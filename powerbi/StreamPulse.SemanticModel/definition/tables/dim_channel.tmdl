	partition dim_channel = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_channel.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"channel_id", type text}, {"channel_title", type text}}, "en-US")
				in
				    Typed

