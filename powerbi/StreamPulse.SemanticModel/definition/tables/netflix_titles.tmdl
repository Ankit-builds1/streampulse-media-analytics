	partition netflix_titles = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "netflix_titles.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"show_id", type text}, {"type", type text}, {"title", type text}, {"main_country", type text}, {"date_added", type date}, {"year_added", Int64.Type}, {"release_year", Int64.Type}, {"rating", type text}, {"listed_in", type text}, {"duration_minutes", type number}, {"seasons", type number}, {"imdb_rating", type number}, {"imdb_votes", type number}, {"imdb_matched", Int64.Type}}, "en-US")
				in
				    Typed

